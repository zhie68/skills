# ============================================================================
# AGENT SKILL RADAR — ENVIRONMENT CONFIGURATION
# ============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://radar:radar_password@localhost:5432/agent_skill_radar?schema=public"

# Cache & Queue (Redis) - Optional fallback to in-memory queue when unavailable
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="false"

# Backend Server
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# GitHub Integration (Optional token increases rate limits from 60/hr to 5000/hr)
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"

# Configurable LLM Provider for AI Skill Analysis
# Supported providers: "openai" | "anthropic" | "gemini" | "heuristic"
LLM_PROVIDER="heuristic"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""

# Scheduled Daily Discovery
DISCOVERY_CRON="0 2 * * *"
DISCOVERY_RATE_LIMIT_MS="1200"
DISCOVERY_MAX_REPOS_PER_SCAN="25"
